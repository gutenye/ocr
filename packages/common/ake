#!/usr/bin/env bun

import { $, app } from '@gutenye/script.js'

app.cmd('build', 'Build the package').add(async () => {
  await $`rm -rf build`
  // tsc-alias still has to rewrite the paths tsc emitted before failing on type errors
  await $`bun run tsc --project tsconfig.build.json`.nothrow()
  await $`bun run tsc-alias --project tsconfig.build.json`
})

app.cmd('publish', 'Publish to npm').add(async () => {
  // build by scripts.prepublishOnly
  await $`npm publish`
})

await app.run()
