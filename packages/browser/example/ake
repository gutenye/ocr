#!/usr/bin/env bun

import { $, app } from '@gutenye/script.js'

// read by build.ts to bake the default image into the bundle
process.env.DEFAULT_IMAGE_PATH = '/assets/cn-01.jpg'

app.cmd('build:watch', 'Rebuild the bundle on source changes').add(async () => {
  await $`chokidar '../../src/**/*.ts' web.ts build.ts -c 'bun run build.ts' --initial`
})

app.cmd('start', 'Build and serve the example').add(async () => {
  // the example serves assets/ over HTTP, and the models are not stored in git
  await $`./ake fetch ch_PP-OCRv4_det_infer.onnx,ch_PP-OCRv4_rec_infer.onnx,ppocr_keys_v1.txt`.cwd('../../models')
  await $`bun run build.ts`
  await app.invoke('start:prod --header Cache-Control:no-cache')
})

app
  .cmd('start:prod', 'Serve the built example')
  .add('[...args]', 'Extra miniserve args')
  .add(async (_args, { argv }) => {
    await $`miniserve build -p 3000 --index index.html --verbose ${argv}`
  })

await app.run()
