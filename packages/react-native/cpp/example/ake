#!/usr/bin/env bun

import { $, app } from '@gutenye/script.js'

app
  .cmd('start', 'Build with cmake and run')
  // the inline `[path=...]` default would lose the dot in the filename
  .add('[path]', 'Image path (default: ./assets/cn-01.jpg)', ['$files'])
  .add(async (path = './assets/cn-01.jpg') => {
    await $`mkdir -p build`
    await $`
      cmake ..
      make
    `.cwd('build')
    await app.invoke('run', path)
  })

app.cmd('start watch', 'Rebuild and run on source changes').add(async () => {
  await $`chokidar '*.cc' '*.h' CMakeLists.txt -c './ake start' --initial`
})

app
  .cmd('run', 'Run the built binary')
  .add('<path>', 'Image path', ['$files'])
  .add(async (path) => {
    await $`./build/ocr ${path}`
  })

await app.run()
